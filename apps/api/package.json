{
  "name": "@recruitflow/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --config jest.integration.config.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.3",
    "@nestjs/core": "^12.3.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.3",
    "@nestjs/swagger": "^12.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@recruitflow/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "^12.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.15.0",
    "jest": "^30.5.2",
    "prisma": "^7.0.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.0"
  }
}
